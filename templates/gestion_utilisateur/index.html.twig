{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="space-page">
    <section class="espace">
        <h1>Gestion des utilisateurs</h1>

        {% for message in app.flashes('success') %}
            <p class="flash-success">{{ message }}</p>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <p class="flash-error">{{ message }}</p>
        {% endfor %}

        {% if utilisateurs is empty %}
            <p>Aucun utilisateur trouvé.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Prénom</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Modifier le rôle</th>
                    </tr>
                </thead>
                <tbody>
                    {% for utilisateur in utilisateurs %}
                        <tr>
                            <td>{{ utilisateur.nom }}</td>
                            <td>{{ utilisateur.prenom }}</td>
                            <td>{{ utilisateur.email }}</td>
                            <td>{{ utilisateur.role.libelleRole }}</td>
                            <td>
                                {% if app.user.id != utilisateur.id %}
                                    <form method="post">
                                        <input type="hidden" name="user" value="{{ utilisateur.id }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('modifier_role_' ~ utilisateur.id) }}">
                                        <select name="role" aria-label="Rôle de {{ utilisateur.prenom }} {{ utilisateur.nom }}">
                                            {% for role in roles %}
                                                <option value="{{ role.idRole }}" {{ role.idRole == utilisateur.role.idRole ? 'selected' : '' }}>
                                                    {{ role.libelleRole }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit">Enregistrer</button>
                                    </form>
                                {% else %}
                                    Votre compte
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
</div>
{% endblock %}
