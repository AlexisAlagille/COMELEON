{% extends 'base.html.twig' %}

{% block title %}Créer une demande{% endblock %}

{% block body %}

<div class="create-demande-container">

    <section>

        <h1>Créer une demande</h1>

        <p>
            Vérifiez les prestations de votre panier, puis indiquez la date souhaitée.
        </p>

        <ul class="demande-prestations">
            {% for prestation in prestations %}
                <li>{{ prestation.titre }} <span>{{ prestation.prix|number_format(2, ',', ' ') }} €</span></li>
            {% endfor %}
        </ul>

        {{ form_start(form) }}

            {{ form_row(form.date) }}

            {{ form_row(form.description) }}

            {{ form_row(form.details) }}

            <button class="demande-submit" type="submit">
                Envoyer la demande
            </button>

        {{ form_end(form) }}

    </section>

</div>

{% endblock %}