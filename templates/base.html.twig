<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="stylesheet" href="/assets/css/style.css"/>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% set currentRoute = app.request.attributes.get('_route') %}
        {% if currentRoute != 'app_espace' and not (currentRoute starts with 'app_espace_') %}
            <nav class="nav-bar">
                <div class="nav-logo">
                    <img class="nav-bar-logo" src="/assets/img/logo_ia.png" alt="logo_entreprise">
                    <h1>Eclat & Vous</h1>
                </div>

                <div class="nav-item-list">
                    <a href="{{path("app_accueil")}}">Accueil</a>
                    <a href="{{path("app_prestations")}}">Prestations</a>
                    {% if app.user %}
                        <a href="{{ path('app_demande')}}">Créer une demande</a>
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">Connexion</a>
                    {% endif %}
                </div>

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{path('app_espace')}}" class="nav-button">Espace Administrateur</a>
                {% elseif is_granted('ROLE_CLIENT') %}
                    <a href="{{path('app_espace')}}" class="nav-button">Espace Client</a>
                {% endif %}
            </nav>
       
        {% else %}
            <nav class="space-nav">
                <div class="space-nav-logo">
                    <img class="space-nav-bar-logo" src="/assets/img/logo_ia.png" alt="logo_entreprise">
                    <h1>Eclat & Vous</h1>
                </div>

                <div class="space-nav-item-list">
                    <a href="{{ path('app_espace') }}" class="space-nav-button{% if currentRoute == 'app_espace' %} is-active{% endif %}">Tableau de bord</a>
                    <a href="{{ path('app_demande') }}" class="space-nav-button">Créer une demande</a>
                    <a href="{{ path('app_logout') }}" class="space-nav-button space-nav-logout">Déconnexion</a>
                </div>
            </nav>
        {% endif %}
        {% block body %}{% endblock %}
    </body>
</html>
