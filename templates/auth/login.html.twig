{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="auth-container">
    <section>
       <h1>Se connecter</h1>
       <p>Accèdez à votre espace personnel et suivez vos demandes.</p>
    </section>
    <section>
        <h1>Connexion</h1>
        <form method="post">
            <label>Email</label>
            <input class="login-input" type="text" name="_username" placeholder="exemple@gmail.com">

            <label>Mot de passe</label>
            <input class="login-input" type="password" name="_password" placeholder="Votre mot de passe">

            <button class="submit-button" type="submit">Se connecter</button>
        </form>
        <p>Pas encore de compte ? <a href="{{path("app_register")}}">Créer un compte</a></p>
    </section>
</div>
{% endblock %}
