{% extends 'base.html.twig' %}

{% block title %}
    {% if is_granted('ROLE_ADMIN') %}
        Espace Administrateur
    {% else %}
        Espace Client
    {% endif %}
{% endblock %}

{% block body %}

<div class="space-page">
    <section class="espace">
        <h1>Mes demandes</h1>

        {# Les 3 cartes #}
        <div class="stats">
            <div class="stat-card">
                <span class="stat-nombre">{{ statuts|length }}</span>
                <span class="stat-label">Total</span>
            </div>
            <div class="stat-card">
                <span class="stat-nombre">{{ statuts|filter(s => s == 'En cours')|length }}</span>
                <span class="stat-label">En cours</span>
            </div>
            <div class="stat-card">
                <span class="stat-nombre">{{ statuts|filter(s => s == 'Terminée')|length }}</span>
                <span class="stat-label">Terminées</span>
            </div>
        </div>

        {# Les 3 dernières demandes #}
        <h2>Dernières demandes</h2>
        {% for demande in demandes|slice(0, 3) %}
            <div class="demande-card">
                <div>
                    <h3>{{ demande.description }}</h3>
                    <p class="demande-date">{{ demande.date|date('d/m/Y') }}</p>
                </div>
                <span class="badge badge-{{ demande.statut.idStatut }}">
                    {{ demande.statut.libelleStatut }}
                </span>
            </div>
        {% else %}
            <p class="vide">Aucune demande pour le moment.</p>
        {% endfor %}
    </section>
</div>

{% endblock %}
